  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && vp build && electron-builder --config electron-builder.json5",
    "release": "tsc && vp build && electron-builder --config electron-builder.json5 --publish always",
    "release:nightly": "tsc && vp build && electron-builder --config electron-builder.nightly.json5 --publish always",
    "check": "vp check",
    "test": "vitest run --root ../.. apps/desktop/test"
  },
