{
  "name": "@store/desktop",
  "version": "0.3.105",
  "private": true,
  "description": "Tabaaq inventory desktop app",
  "homepage": "https://github.com/zohaibakber/store",
  "author": "Zohaib Akber <zohaibakber99@gmail.com>",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && vp build && electron-builder --config electron-builder.json5",
    "release": "tsc && vp build && electron-builder --config electron-builder.json5 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@effect/platform-browser": "catalog:",
    "@effect/platform-node": "catalog:",
    "@electron/asar": "^4.3.1",
    "@electron/fuses": "^2.1.3",
    "@sentry/effect": "11.7.0",
    "@sentry/electron": "8.2.0",
    "@store/auth": "workspace:*",
    "@store/client-db": "workspace:*",
    "@store/contracts": "workspace:*",
    "@store/services": "workspace:*",
    "@store/sync": "workspace:*",
    "@store/web": "workspace:*",
    "@store/workspace": "workspace:*",
    "effect": "catalog:",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-electron": "1.1.2",
    "vite-plus": "catalog:",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.27.1",
      "onFail": "download"
    }
  },
  "desktopName": "Tabaaq.desktop"
}
