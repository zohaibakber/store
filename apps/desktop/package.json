    "@electron/fuses": "^2.1.3",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@sentry/electron": "7.20.0",
    "@sentry/react": "10.75.2",
    "@store/auth": "workspace:*",
    "@store/client-db": "workspace:*",
    "@store/contracts": "workspace:*",
    "@store/inventory-react": "workspace:*",
    "@store/services": "workspace:*",
