// @see - https://www.electron.build/configuration/configuration
{
  $schema: "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  appId: "com.tabaaq.desktop",
  executableName: "tabaaq",
  asar: true,
  asarUnpack: ["**/*.node"],
  // Fail before signing or publishing if monorepo/server sources, credentials,
  // or database schema code land in the packaged app.
  afterPack: "./scripts/verify-after-pack.cjs",
  productName: "Tabaaq",
  protocols: [
    {
      name: "Tabaaq",
      schemes: ["com.tabaaq.desktop"],
    },
  ],
  directories: {
    output: "release/${version}",
  },
  // The source repo is public, so releases and auto-update checks publish
  // here, not to a separate releases-only repo.
  publish: [
    {
      provider: "github",
      owner: "zohaibakber",
      repo: "store",
      // Both platform jobs upload into the same draft. The release workflow
      // publishes it only after every platform and update manifest is present.
      releaseType: "draft",
    },
  ],
  files: ["dist", "dist-electron"],
  // Packaged/prod uses the monochrome mark. Unpackaged `vp dev` loads the
  // orange mark from apps/web/public/logo-dev.png in the main process.
  icon: "assets/prod/icon.png",
  extraResources: [
    {
      // BrowserWindow's `icon` option loads through nativeImage, which reads
      // the real filesystem and can't see into app.asar. The icon must live
      // outside the archive to show up at runtime in production.
      from: "assets/prod/icon.png",
      to: "logo.png",
    },
  ],
  mac: {
    target: ["dmg"],
    artifactName: "${productName}-Mac-${version}-Installer.${ext}",
  },
  win: {
    target: [
      {
        target: "nsis",
        arch: ["x64"],
      },
    ],
    artifactName: "${productName}-Windows-${version}-Setup.${ext}",
  },
  nsis: {
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    deleteAppDataOnUninstall: false,
  },
  linux: {
    target: ["AppImage"],
    artifactName: "${productName}-Linux-${version}.${ext}",
    category: "Office",
    maintainer: "Zohaib Akber <zohaibakber99@gmail.com>",
    // electron-builder's icon converter copies a single source PNG as-is
    // instead of generating the standard hicolor size ladder, so the
    // launcher/app-search icon fails to resolve even though it's present.
    // A pre-sized icon set directory forces it to ship all standard sizes.
    // Named after executableName (`tabaaq`), not the old `store-electron`
    // template key. Linux icon themes cache by that name, so a leftover teal
    // store-electron.png would otherwise keep showing after updates.
    icon: "assets/prod/icons",
    desktop: {
      entry: {
        Icon: "tabaaq",
        StartupWMClass: "Tabaaq",
      },
    },
    // package.json's "name" is the scoped npm name "@store/desktop", which is
    // invalid as a WM_CLASS/app_id. syncDesktopName (paired with
    // package.json's "desktopName") makes the installed .desktop filename
    // match StartupWMClass and Electron's app_id. Desktop environments can
    // then link the running window to the installed .desktop entry. Without
    // that match, launcher and search icons fail even when the taskbar icon
    // looks fine.
    syncDesktopName: true,
  },
}
