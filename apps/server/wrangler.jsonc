{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "store-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "mode": "smart",
  },
  "ai": {
    "binding": "AI",
  },
  // Better Auth identity tables. The per-organization store lives in Durable
  // Object SQLite, not here — D1 holds only what needs a global lookup.
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "store-auth",
      "database_id": "1047eb8f-22ef-4fa1-b4e1-6a7acec7bfde",
      "migrations_dir": "../../packages/db/migrations/auth",
      // drizzle-kit emits `<tag>/migration.sql` rather than flat files.
      "migrations_pattern": "../../packages/db/migrations/auth/*/migration.sql",
    },
  ],
  // One Durable Object per organization, each with its own SQLite database.
  "durable_objects": {
    "bindings": [
      {
        "name": "ORGANIZATION_STORE",
        "class_name": "OrganizationStore",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OrganizationStore"],
    },
  ],
  "vars": {
    "AUTH_TRUSTED_ORIGINS": "http://localhost:5173",
    "ELECTRON_PROTOCOL": "com.tabaaq.desktop",
  },
  "observability": {
    "enabled": true,
  },
}
