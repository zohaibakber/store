{
  "name": "sync-workerd-proofs",
  "main": "./worker.ts",
  "compatibility_date": "2026-07-11",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "PROOF",
        "class_name": "SyncWorkerdProof",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SyncWorkerdProof"],
    },
  ],
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "workerd-proof-snapshots",
    },
  ],
}
