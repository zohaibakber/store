{
  "cli": {
    "version": ">= 24.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.11.1",
      "pnpm": "11.22.0",
      "android": {
        "image": "latest"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      },
      "android": {
        "image": "latest",
        "buildType": "apk"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "production"
      },
      "android": {
        "image": "latest",
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "env": {
        "APP_VARIANT": "production"
      },
      "android": {
        "image": "latest",
        "buildType": "app-bundle"
      }
    }
  }
}
