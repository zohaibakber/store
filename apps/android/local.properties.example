## Copy to local.properties (gitignored). Android Studio also writes sdk.dir here.
sdk.dir=/Users/YOU/Library/Android/sdk

## First-party auth + inventory API. Same origins as VITE_AUTH_URL / VITE_API_URL.
AUTH_URL=http://10.0.2.2:8788
API_URL=http://10.0.2.2:8787

## Optional. PowerSync URL is normally returned by GET /api/powersync/credentials.
## Set this only when you want a fallback before the API answers.
POWERSYNC_URL=

## Google Identity Services web client ID. Required for the native Google button.
## Must match GOOGLE_OAUTH_CLIENT_ID.
GOOGLE_WEB_CLIENT_ID=

## Native origin sent as expo-origin. Worker trusts com.tabaaq.mobile://
NATIVE_ORIGIN=com.tabaaq.mobile://app
