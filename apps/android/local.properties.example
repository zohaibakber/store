## Copy to local.properties (gitignored). Android Studio also writes sdk.dir here.
sdk.dir=/Users/YOU/Library/Android/sdk

## First-party auth + inventory API. Same origins Expo reads from EXPO_PUBLIC_*.
AUTH_URL=http://10.0.2.2:8788
API_URL=http://10.0.2.2:8787

## Optional. PowerSync URL is normally returned by GET /api/powersync/credentials.
## Set this only when you want a fallback before the API answers.
POWERSYNC_URL=

## Google Identity Services web client ID. Required for the native Google button.
## Must match EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID / GOOGLE_OAUTH_CLIENT_ID.
GOOGLE_WEB_CLIENT_ID=

## Debug vs release native origin sent as expo-origin.
## The auth Worker currently trusts com.tabaaq.mobile:// so this app reuses that
## origin until ANDROID_PROTOCOL is added server-side.
NATIVE_ORIGIN=com.tabaaq.mobile://app
