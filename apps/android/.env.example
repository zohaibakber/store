# STORE_API_BASE_URL: base URL of the store-electron server (apps/server),
# e.g. a deployed Cloudflare Worker URL from `bun run deploy:dev`/`deploy:prod`.
# Must be reachable from wherever the app runs — the AI Studio remote emulator
# cannot reach a developer machine's localhost, so this cannot be localhost.
STORE_API_BASE_URL=https://example.workers.dev

# Product-label parsing now goes through the Firebase AI Logic SDK (cloud
# Gemini), not a raw API key — see apps/android/AGENTS.md for the required
# google-services.json / Firebase project setup. No GEMINI_API_KEY needed here.
