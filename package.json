{
  "name": "store-electron",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run --parallel dev",
    "build:desktop": "vp run --filter @store/desktop build",
    "build": "vp run -r build",
    "lint:design": "vp lint -c .oxlintrc.design.json apps/desktop/src",
    "licence": "node packages/licence/run.mjs",
    "plan:dev": "pnpm exec alchemy plan --stage dev --env-file .env.dev",
    "deploy:dev": "pnpm exec alchemy deploy --stage dev --env-file .env.dev",
    "plan:prod": "pnpm exec alchemy plan --stage prod --env-file .env.prod",
    "deploy:prod": "pnpm exec alchemy deploy --stage prod --env-file .env.prod",
    "destroy:dev": "pnpm exec alchemy destroy --stage dev --env-file .env.dev",
    "setup:ci": "pnpm exec alchemy deploy stacks/github.ts --stage prod --profile admin",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@shadcn/lint": "0.2.3",
    "@types/node": "^26.6.5",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0"
}
