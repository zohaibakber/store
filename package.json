{
  "name": "store-electron",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build:desktop": "vp run --filter @store/desktop build",
    "build": "turbo run build",
    "check": "node scripts/check-powersync-migration.mjs && turbo run check",
    "check:powersync-migration": "node scripts/check-powersync-migration.mjs",
    "lint:design": "oxlint -c .oxlintrc.design.json apps/desktop/src",
    "test": "turbo run test",
    "plan:dev": "pnpm exec alchemy plan --stage dev --env-file .env.dev",
    "deploy:dev": "pnpm exec alchemy deploy --stage dev --env-file .env.dev",
    "plan:nightly": "pnpm exec alchemy plan --stage nightly --env-file .env.nightly",
    "deploy:nightly": "pnpm exec alchemy deploy --stage nightly --env-file .env.nightly",
    "plan:prod": "pnpm exec alchemy plan --stage prod --env-file .env.prod",
    "deploy:prod": "pnpm exec alchemy deploy --stage prod --env-file .env.prod",
    "destroy:dev": "pnpm exec alchemy destroy --stage dev --env-file .env.dev",
    "setup:ci": "pnpm exec alchemy deploy stacks/github.ts --stage prod --profile admin",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@effect/platform-bun": "4.0.0-rc.111",
    "@effect/platform-node": "4.0.0-rc.111",
    "@oxlint/plugins": "1.83.0",
    "@shadcn/lint": "0.1.0",
    "@types/node": "^26.5.1",
    "alchemy": "catalog:",
    "effect": "4.0.0-rc.111",
    "oxlint": "1.83.0",
    "turbo": "^2.10.13",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.2",
    "vite-plus": "^0.3.2",
    "wrangler": "^4.131.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.22.0"
}
