{
  "name": "store-electron",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build:desktop": "vp run --filter @store/desktop build",
    "build": "turbo run build",
    "check": "node scripts/check-retired-vendors.mjs && turbo run check",
    "check:retired-vendors": "node scripts/check-retired-vendors.mjs",
    "migrate:cloudflare": "pnpm --filter @store/migrate-cloudflare start",
    "lint:design": "oxlint -c .oxlintrc.design.json apps/desktop/src",
    "test": "turbo run test",
    "plan:dev": "pnpm exec alchemy plan --stage dev --env-file .env.dev",
    "deploy:dev": "pnpm exec alchemy deploy --stage dev --env-file .env.dev",
    "plan:nightly": "pnpm exec alchemy plan --stage nightly --env-file .env.nightly",
    "deploy:nightly": "pnpm exec alchemy deploy --stage nightly --env-file .env.nightly",
    "plan:prod": "pnpm exec alchemy plan --stage prod --env-file .env.prod",
    "deploy:prod": "pnpm exec alchemy deploy --stage prod --env-file .env.prod",
    "destroy:dev": "pnpm exec alchemy destroy --stage dev --env-file .env.dev",
    "setup:ci": "pnpm exec alchemy deploy stacks/github.ts --stage prod --profile admin",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260923.1",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@oxlint/plugins": "1.85.0",
    "@shadcn/lint": "0.2.0",
    "@types/node": "^26.6.2",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "oxlint": "1.85.0",
    "turbo": "^2.11.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.0",
    "vite-plus": "^1.0.0-rc.0",
    "wrangler": "^4.136.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.22.0"
}
