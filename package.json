{
  "name": "store-electron",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run --filter @store/server dev",
    "dev:web": "vp run --filter @store/server dev",
    "dev:desktop": "cross-env STORE_DESKTOP_RENDERER=1 VITE_DEV_SERVER_URL=http://127.0.0.1:5174 vp run --filter @store/server --filter @store/desktop dev",
    "build:web": "vp run --filter @store/web build",
    "build:desktop": "vp run --filter @store/desktop build",
    "build": "turbo run build",
    "check": "node scripts/check-powersync-migration.mjs && turbo run check",
    "check:powersync-migration": "node scripts/check-powersync-migration.mjs",
    "test": "turbo run test",
    "plan:dev": "pnpm exec alchemy plan --stage dev --env-file .env.dev",
    "deploy:dev": "pnpm exec alchemy deploy --stage dev --env-file .env.dev",
    "plan:prod": "pnpm exec alchemy plan --stage prod --env-file .env.prod",
    "deploy:prod": "pnpm exec alchemy deploy --stage prod --env-file .env.prod",
    "destroy:dev": "pnpm exec alchemy destroy --stage dev --env-file .env.dev",
    "setup:ci": "pnpm exec alchemy deploy stacks/github.ts --stage prod --profile admin",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260822.1",
    "@effect/platform-bun": "4.0.0-rc.111",
    "@effect/platform-node": "4.0.0-rc.111",
    "@oxlint/plugins": "1.79.0",
    "@types/node": "^26.2.0",
    "alchemy": "catalog:",
    "cross-env": "^10.1.0",
    "effect": "4.0.0-rc.111",
    "oxlint": "1.79.0",
    "tsx": "^4.23.12",
    "turbo": "^2.10.11",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plus": "^0.2.9",
    "wrangler": "^4.125.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.22.0"
}
