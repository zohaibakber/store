{
  "name": "store-electron",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run --parallel --filter '!@store/web' dev",
    "dev:web": "vp run --parallel --filter @store/server --filter @store/web dev",
    "build:desktop": "vp run --filter @store/desktop build",
    "build": "vp run -r build",
    "lint:design": "oxlint -c .oxlintrc.design.json apps/web/src",
    "plan:dev": "pnpm exec alchemy plan --stage dev --env-file .env.dev",
    "deploy:dev": "pnpm exec alchemy deploy --stage dev --env-file .env.dev",
    "plan:prod": "pnpm exec alchemy plan --stage prod --env-file .env.prod",
    "deploy:prod": "pnpm exec alchemy deploy --stage prod --env-file .env.prod",
    "destroy:dev": "pnpm exec alchemy destroy --stage dev --env-file .env.dev",
    "setup:ci": "pnpm exec alchemy deploy stacks/github.ts --stage prod --profile admin",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@oxlint/plugins": "1.88.0",
    "@shadcn/lint": "0.2.1",
    "@types/node": "^26.6.5",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "oxlint": "1.88.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "^1.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.27.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.27.1",
  "op-sqlite": {
    "fts5": true
  }
}
