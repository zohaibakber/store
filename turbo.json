{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": [
    "STORE_API_URL",
    "VITE_API_URL",
    "BETTER_AUTH_SECRET",
    "AUTH_TRUSTED_ORIGINS",
    "ELECTRON_PROTOCOL",
    "CLOUDFLARE_API_TOKEN",
    "CLOUDFLARE_ACCOUNT_ID",
    "ALCHEMY_PROFILE",
    "STAGE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**", "release/**"]
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    }
  }
}
