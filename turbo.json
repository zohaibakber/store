{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": [
    "STORE_API_URL",
    "VITE_API_URL",
    "VITE_CLERK_PUBLISHABLE_KEY",
    "VITE_CLERK_FAPI_URL",
    "VITE_CLERK_JWT_TEMPLATE",
    "PRODUCTION_DOMAIN",
    "PRODUCTION_API_DOMAIN",
    "EXPO_PUBLIC_API_URL",
    "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "EXPO_PUBLIC_CLERK_JWT_TEMPLATE",
    "CLERK_SECRET_KEY",
    "CLERK_JWT_KEY",
    "CLERK_JWT_AUDIENCE",
    "AUTH_TRUSTED_ORIGINS",
    "ELECTRON_PROTOCOL",
    "MOBILE_PROTOCOL",
    "CLOUDFLARE_API_TOKEN",
    "CLOUDFLARE_ACCOUNT_ID",
    "ALCHEMY_PROFILE",
    "STAGE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**", "release/**"]
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "test": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
