{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": [
    "STORE_API_URL",
    "VITE_API_URL",
    "VITE_AUTH_URL",
    "VITE_DEV_SERVER_URL",
    "STORE_DESKTOP_RENDERER",
    "STORE_DESKTOP_DEV",
    "PRODUCTION_DOMAIN",
    "PRODUCTION_API_DOMAIN",
    "PRODUCTION_AUTH_DOMAIN",
    "EXPO_PUBLIC_API_URL",
    "EXPO_PUBLIC_AUTH_URL",
    "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID",
    "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID",
    "AUTH_BASE_URL",
    "AUTH_JWT_PRIVATE_JWK",
    "AUTH_JWT_PUBLIC_JWK",
    "AUTH_REFRESH_TOKEN_PEPPER",
    "AUTH_EPHEMERAL_PEPPER",
    "AUTH_DEV_OTP",
    "AUTH_TRUSTED_ORIGINS",
    "GOOGLE_OAUTH_CLIENT_ID",
    "GOOGLE_OAUTH_CLIENT_SECRET",
    "GOOGLE_OAUTH_NATIVE_CLIENT_IDS",
    "ELECTRON_PROTOCOL",
    "MOBILE_PROTOCOL",
    "CLOUDFLARE_API_TOKEN",
    "CLOUDFLARE_ACCOUNT_ID",
    "ALCHEMY_PROFILE",
    "STAGE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**", "release/**"]
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "test": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
