# Copy to `.env.dev` and `.env.prod`. Use separate keys and peppers per stage.

# ES256 signing key pair. Keep the private JWK secret; the public JWK is safe
# to share with the API Worker.
AUTH_JWT_PRIVATE_JWK=
AUTH_JWT_PUBLIC_JWK=
AUTH_REFRESH_TOKEN_PEPPER=
AUTH_EPHEMERAL_PEPPER=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Development only. Returns the OTP in the identify response and logs it.
AUTH_DEV_OTP=true

# Production Website hostname (no scheme). Required for `deploy:prod`.
# API and auth default to `api.<PRODUCTION_DOMAIN>` and
# `auth.<PRODUCTION_DOMAIN>`.
PRODUCTION_DOMAIN=
PRODUCTION_API_DOMAIN=
PRODUCTION_AUTH_DOMAIN=
AUTH_BASE_URL=http://localhost:8788
AUTH_TRUSTED_ORIGINS=

ELECTRON_PROTOCOL=com.tabaaq.desktop
MOBILE_PROTOCOL=com.tabaaq.mobile

# Desktop / mobile / web clients
VITE_API_URL=http://localhost:8787
VITE_AUTH_URL=http://localhost:8788
EXPO_PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_AUTH_URL=http://localhost:8788
