# Copy to `.env.dev` and `.env.prod`. Use a different CLERK_SECRET_KEY per
# Clerk instance. The publishable key is public; the secret key is not.

CLERK_SECRET_KEY=
# Optional. PEM JWKS for networkless JWT verify on the Worker.
CLERK_JWT_KEY=
# Optional. Must match a Clerk JWT template audience if you create one.
CLERK_JWT_AUDIENCE=
# Production Website hostname (no scheme). Required for `deploy:prod`.
# API hostname is `api.<PRODUCTION_DOMAIN>` unless PRODUCTION_API_DOMAIN or
# VITE_API_URL says otherwise. AUTH_TRUSTED_ORIGINS must include the site origin.
PRODUCTION_DOMAIN=
PRODUCTION_API_DOMAIN=
AUTH_TRUSTED_ORIGINS=

ELECTRON_PROTOCOL=com.tabaaq.desktop
MOBILE_PROTOCOL=com.tabaaq.mobile

# Desktop / mobile / web clients
VITE_API_URL=http://localhost:8787
VITE_CLERK_PUBLISHABLE_KEY=
# Optional. Clerk Frontend API origin for the web CSP (otherwise derived from
# VITE_CLERK_PUBLISHABLE_KEY). Example: https://clerk.example.com
VITE_CLERK_FAPI_URL=
VITE_CLERK_JWT_TEMPLATE=
EXPO_PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_CLERK_JWT_TEMPLATE=
# Optional. Native Google Sign-In. Unset values must stay blank (not {}).
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME=
