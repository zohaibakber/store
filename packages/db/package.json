{
  "name": "@store/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./auth.schema": "./src/auth/schema.ts",
    "./auth/infra": "./src/auth/infra.ts",
    "./postgres/infra": "./src/postgres/infra.ts",
    "./postgres/schema": "./src/postgres/schema.ts",
    "./store.schema": "./src/shared/store.schema.ts"
  },
  "scripts": {
    "check": "tsc --noEmit && node scripts/drizzle-kit.cjs check --config drizzle.auth.config.ts && node scripts/drizzle-kit.cjs check --config drizzle.postgres.config.ts",
    "db:generate": "node scripts/drizzle-kit.cjs generate --config drizzle.postgres.config.ts"
  },
  "dependencies": {
    "@distilled.cloud/neon": "1.0.0-rc.6",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "nanoid": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "alchemy": "catalog:",
    "drizzle-kit": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:"
  }
}
