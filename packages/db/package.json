{
  "name": "@store/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./auth.schema": "./src/auth/schema.ts",
    "./auth/infra": "./src/auth/infra.ts",
    "./postgres/infra": "./src/postgres/infra.ts",
    "./postgres/schema": "./src/postgres/schema.ts",
    "./postgres/stage": "./src/postgres/stage.ts",
    "./store.schema": "./src/shared/store.schema.ts",
    "./replica.schema": "./src/replica/schema.ts",
    "./replica/migrations": "./src/replica/migrations.gen.ts"
  },
  "scripts": {
    "check": "tsc --noEmit && node scripts/build-migration-bundle.mjs --check && node scripts/drizzle-kit.cjs check --config drizzle.auth.config.ts && node scripts/drizzle-kit.cjs check --config drizzle.postgres.config.ts && node scripts/drizzle-kit.cjs check --config drizzle.replica.config.ts",
    "db:generate": "node scripts/drizzle-kit.cjs generate --config drizzle.postgres.config.ts",
    "db:bundle": "node scripts/build-migration-bundle.mjs"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "nanoid": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "alchemy": "catalog:",
    "drizzle-kit": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:"
  }
}
