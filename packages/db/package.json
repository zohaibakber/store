{
  "name": "@store/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./analytics.schema": "./src/analytics/schema.ts",
    "./analytics/migrations": "./src/analytics/migrations.gen.ts",
    "./auth.schema": "./src/auth/schema.ts",
    "./authority.schema": "./src/authority/schema.ts",
    "./authority/migrations": "./src/authority/migrations.gen.ts",
    "./auth/infra": "./src/auth/infra.ts",
    "./store.schema": "./src/shared/store.schema.ts",
    "./replica.schema": "./src/replica/schema.ts",
    "./replica/migrations": "./src/replica/migrations.gen.ts"
  },
  "scripts": {
    "check": "tsc --noEmit && node scripts/build-migration-bundle.mjs --check && node scripts/drizzle-kit.cjs check --config drizzle.auth.config.ts && node scripts/drizzle-kit.cjs check --config drizzle.replica.config.ts && node scripts/drizzle-kit.cjs check --config drizzle.analytics.config.ts && node scripts/drizzle-kit.cjs check --config drizzle.authority.config.ts && node scripts/check-schema-drift.mjs",
    "db:bundle": "node scripts/build-migration-bundle.mjs"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "nanoid": "^6.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "alchemy": "catalog:",
    "drizzle-kit": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:"
  }
}
